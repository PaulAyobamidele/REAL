# real-av Review: the review interface on the bundled example rounds, with the
# requirement checker behind it, in one container - no simulator, GPU or
# network needed at run time. Built for linux/amd64 and linux/arm64.
#
#   docker build -f Dockerfile.review -t real-review .
#   docker run --rm -p 8080:80 real-review          # then open http://localhost:8080
#   docker run --rm -p 8080:80 ghcr.io/paulayobamidele/real-tool   # published image
#
# Stage 1 runs the laptop-side demo (analysis, comparison, scripted review,
# proposed requirement) on the two bundled rounds; stage 2 adds round C1 (the
# paper's round, copied as presented, never re-analysed), builds the interface
# and lists that workspace for static serving, each round labelled; stage 3 serves both
# with nginx and runs the authoring helper (scripts/redsl/serve.py) behind
# /authoring, so the requirement editor parses with the project's own parser.
# Signing inside the container offers the files as downloads (the served
# folder is read-only); open a local folder in Chrome or Edge to write in place.
# The Run panel needs the cluster connection and does not work in the container.

FROM python:3.8-slim AS demo
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/real
WORKDIR /opt/real
COPY requirements-demo.txt .
RUN pip install --no-cache-dir -r requirements-demo.txt
COPY real_config.py ./
COPY scripts/demo.py scripts/demo.py
COPY scripts/analysis/ scripts/analysis/
COPY scripts/redsl/ scripts/redsl/
COPY scripts/evolve/ scripts/evolve/
COPY scripts/templates/ scripts/templates/
COPY scripts/scenarios/scratch.temp scripts/scenarios/scratch.temp
COPY docs/examples/ docs/examples/
COPY examples/demo_runs/ examples/demo_runs/
RUN python -m scripts.demo --out /work/demo

FROM node:22-alpine AS build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
# the REAL-DSL manual, shown in the tool (imported as @docs/manual/real-dsl.md)
COPY docs/manual/ /docs/manual/
COPY --from=demo /work/demo/runs /work/runs
# round C1 beside them: the study's round (the paper's and the video's), as presented
COPY examples/round_C1/ /work/runs/
# readable whoever builds it: the copies keep the modes they had on the building
# machine, and nginx's worker in the final image is not their owner
RUN chmod -R a+rX /work/runs \
 && rm -rf public/workspace \
 && node scripts/make-workspace-index.mjs /work/runs --out public/workspace --example \
      --label "Example workspace: demo rounds 1 and 2 (test scene v1) and round C1 (the paper's round, scene v2)" \
      --note "35acc09e8c224fdc953e3bf82ba57e96=Demo round 1: emergency braking on the first test scene (v1, later repaired). Analysed, compared with round 2." \
      --note "882fb2fe00bf4568bdb480a281db9e8b=Demo round 2: proportional braking on test scene v1. Signed by the scripted review: its decisions, R1 and diff are on file." \
      --note "fbf8bbcfe2d759778e6ba73d9bd43412=Round C1: the round in the paper and the video. Proportional braking with the yolov5s detector on test scene v2, 288 scenarios x 3 runs, judged against the study requirement. Not yet reviewed: start at the requirement under test." \
 && npm run build

# The catalog lists the detector modules by the names of the weights files;
# nothing runs a detector here, so only empty files with those names are kept.
FROM busybox AS models
COPY model/ /m/
RUN mkdir /names && for f in /m/*.pt; do : > "/names/$(basename "$f")"; done

FROM python:3.8-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/real
RUN apt-get update && apt-get install -y --no-install-recommends nginx \
 && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default
WORKDIR /opt/real
RUN pip install --no-cache-dir pandas==1.5.3 numpy==1.24.4 lark==1.3.1 pydantic==1.10.26
COPY real_config.py ./
COPY scripts/analysis/ scripts/analysis/
COPY scripts/redsl/ scripts/redsl/
COPY scripts/evolve/ scripts/evolve/
COPY scripts/simulations/util.py scripts/simulations/util.py
COPY docs/examples/ docs/examples/
COPY --from=models /names/ model/
COPY --from=build /ui/dist /usr/share/nginx/html
COPY infra/docker/review/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/docker/review/start.sh /start.sh
EXPOSE 80
CMD ["sh", "/start.sh"]
